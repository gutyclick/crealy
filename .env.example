NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this value to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
FOUR_K_GENERATION_ENABLED=false
OPENAI_GENERATION_ENABLED=true
GENERATION_DAILY_LIMIT=10
GENERATION_COOLDOWN_SECONDS=15
OPENAI_RESPONSES_MODEL=gpt-5.6-luna
OPENAI_EDITING_ENABLED=true
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
THUMBNAIL_ANALYSIS_ENABLED=true
THUMBNAIL_ANALYSIS_DAILY_LIMIT=5
THUMBNAIL_ANALYSIS_FREE_DAILY_LIMIT=1
THUMBNAIL_ANALYSIS_CREDIT_COST=1
REFERENCE_IMAGE_MAX_MB=10
REFERENCE_IMAGE_MAX_WIDTH=8192
REFERENCE_IMAGE_MAX_HEIGHT=8192
REFERENCE_IMAGE_MAX_PIXELS=40000000
EDIT_DAILY_LIMIT=20
EDIT_COOLDOWN_SECONDS=12
EDIT_SESSION_VERSION_LIMIT=20

# Public visual tools
NEXT_PUBLIC_TOOLS_ENABLED=true
NEXT_PUBLIC_YOUTUBE_DOWNLOADS_ENABLED=true
NEXT_PUBLIC_THUMBNAIL_ANALYSIS_ENABLED=true
NEXT_PUBLIC_THUMBNAIL_COMPARATOR_ENABLED=true
TOOLS_PUBLIC_REQUESTS_PER_MINUTE=60
YOUTUBE_DOWNLOADER_REQUESTS_PER_MINUTE=30
# Required only for the public YouTube banner lookup.
YOUTUBE_DATA_API_KEY=

# Stripe server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_PRICE_DISPLAY=
# Presentation only; the Price ID remains the source of truth for charging.
STRIPE_PRO_PRICE_DISPLAY=

# Credits
FREE_SIGNUP_CREDITS=5
PRO_MONTHLY_CREDITS=100
BUSINESS_MONTHLY_CREDITS=500
CREDITS_COST_GENERATION_STANDARD=1
CREDITS_COST_GENERATION_HIGH=2
CREDITS_COST_EDIT=1

# Billing
STRIPE_BILLING_ENABLED=false
BUSINESS_PLAN_ENABLED=false
BILLING_GRACE_PERIOD_DAYS=3

# Durable jobs and operations (server only)
JOBS_WORKER_ENABLED=true
JOBS_GLOBAL_CONCURRENCY=3
JOBS_USER_CONCURRENCY=1
JOBS_VISIBILITY_TIMEOUT_SECONDS=300
JOBS_MAX_ATTEMPTS=4
CRON_SECRET=
IP_HASH_SALT=

# Optional OpenAI safety budgets. Leave blank to disable the monetary guard.
OPENAI_DAILY_BUDGET_USD=
OPENAI_MONTHLY_BUDGET_USD=
# Configure estimates from your own measured/current provider costs.
OPENAI_GENERATION_STANDARD_ESTIMATED_COST_USD=
OPENAI_GENERATION_HIGH_ESTIMATED_COST_USD=
OPENAI_EDIT_ESTIMATED_COST_USD=

# Private upload quotas
UPLOAD_MAX_FILES_PER_USER=100
UPLOAD_MAX_TOTAL_MB_PER_USER=500

# Private object storage. Use supabase locally while R2 is not configured.
OBJECT_STORAGE_PROVIDER=supabase
# Legacy alias during migration.
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=generations
# Required only when OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Leave empty for private files.
R2_PUBLIC_BASE_URL=

# Asset retention
TEMPORARY_ASSET_RETENTION_HOURS=24
UPLOAD_UNUSED_RETENTION_HOURS=24
FREE_ASSET_RETENTION_DAYS=30
PRO_ASSET_RETENTION_DAYS=90
PREVIEW_RETENTION_DAYS=180
DELETION_GRACE_PERIOD_DAYS=7

# Storage quotas
FREE_STORAGE_LIMIT_MB=
PRO_STORAGE_LIMIT_MB=
MAX_SINGLE_UPLOAD_MB=10
