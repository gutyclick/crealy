NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this value to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_GENERATION_ENABLED=true
GENERATION_DAILY_LIMIT=10
GENERATION_COOLDOWN_SECONDS=15
OPENAI_RESPONSES_MODEL=gpt-5.6-luna
OPENAI_EDITING_ENABLED=true
REFERENCE_IMAGE_MAX_MB=10
REFERENCE_IMAGE_MAX_WIDTH=8192
REFERENCE_IMAGE_MAX_HEIGHT=8192
REFERENCE_IMAGE_MAX_PIXELS=40000000
EDIT_DAILY_LIMIT=20
EDIT_COOLDOWN_SECONDS=12
EDIT_SESSION_VERSION_LIMIT=20

# Stripe server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_PRICE_DISPLAY=
# Presentation only; the Price ID remains the source of truth for charging.
STRIPE_PRO_PRICE_DISPLAY=

# Credits
FREE_SIGNUP_CREDITS=5
PRO_MONTHLY_CREDITS=100
BUSINESS_MONTHLY_CREDITS=500
CREDITS_COST_GENERATION_STANDARD=1
CREDITS_COST_GENERATION_HIGH=2
CREDITS_COST_EDIT=1

# Billing
STRIPE_BILLING_ENABLED=false
BUSINESS_PLAN_ENABLED=false
BILLING_GRACE_PERIOD_DAYS=3

# Durable jobs and operations (server only)
JOBS_WORKER_ENABLED=true
JOBS_GLOBAL_CONCURRENCY=3
JOBS_USER_CONCURRENCY=1
JOBS_VISIBILITY_TIMEOUT_SECONDS=300
JOBS_MAX_ATTEMPTS=4
CRON_SECRET=
IP_HASH_SALT=

# Optional OpenAI safety budgets. Leave blank to disable the monetary guard.
OPENAI_DAILY_BUDGET_USD=
OPENAI_MONTHLY_BUDGET_USD=
# Configure estimates from your own measured/current provider costs.
OPENAI_GENERATION_STANDARD_ESTIMATED_COST_USD=
OPENAI_GENERATION_HIGH_ESTIMATED_COST_USD=
OPENAI_EDIT_ESTIMATED_COST_USD=

# Private upload quotas
UPLOAD_MAX_FILES_PER_USER=100
UPLOAD_MAX_TOTAL_MB_PER_USER=500
