NEXT_PUBLIC_SPEED_INSIGHTS_ENABLED=false

# Support and feedback
SUPPORT_FORM_ENABLED=true
SUPPORT_REQUESTS_PER_HOUR=5
PRODUCT_FEEDBACK_ENABLED=true
DATA_EXPORT_ENABLED=false
ACCOUNT_DELETION_ENABLED=false

