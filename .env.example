NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_DISCORD_AUTH_ENABLED=false
# Server only. Never expose this value to the browser.
SUPABASE_SECRET_KEY=
# Solo pruebas E2E. Debe ser un proyecto Supabase separado y desechable.
E2E_ALLOW_REMOTE_TEST_PROJECT=false
E2E_REQUIRE_CONFIG=false
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_SECRET_KEY=
E2E_SUPABASE_PROJECT_REF=
# Secreto efímero que debe coincidir con STRIPE_WEBHOOK_SECRET en E2E.
E2E_STRIPE_WEBHOOK_SECRET=
AUTH_E2E_DIAGNOSTICS=false
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CANONICAL_HOST=
# Webmaster verification tokens. Paste only the token value, not the full tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Optional ISO timestamp. If omitted, sitemap lastmod uses the deployment build time.
SITE_LAST_MODIFIED=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
FOUR_K_GENERATION_ENABLED=false
OPENAI_GENERATION_ENABLED=true
OPENAI_RESPONSES_MODEL=gpt-5.6-luna
OPENAI_EDITING_ENABLED=true
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
THUMBNAIL_ANALYSIS_ENABLED=true
THUMBNAIL_ANALYSIS_DAILY_LIMIT=5
THUMBNAIL_ANALYSIS_FREE_DAILY_LIMIT=1
THUMBNAIL_ANALYSIS_CREDIT_COST=1
REFERENCE_IMAGE_MAX_MB=10
REFERENCE_IMAGE_MAX_WIDTH=8192
REFERENCE_IMAGE_MAX_HEIGHT=8192
REFERENCE_IMAGE_MAX_PIXELS=40000000
EDIT_DAILY_LIMIT=20
EDIT_COOLDOWN_SECONDS=12
EDIT_SESSION_VERSION_LIMIT=20

# Public visual tools
NEXT_PUBLIC_TOOLS_ENABLED=true
NEXT_PUBLIC_YOUTUBE_DOWNLOADS_ENABLED=true
NEXT_PUBLIC_THUMBNAIL_ANALYSIS_ENABLED=true
NEXT_PUBLIC_THUMBNAIL_COMPARATOR_ENABLED=true
TOOLS_PUBLIC_REQUESTS_PER_MINUTE=60
YOUTUBE_DOWNLOADER_REQUESTS_PER_MINUTE=30
# Required only for the public YouTube banner lookup.
YOUTUBE_DATA_API_KEY=

# Stripe server only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_CREATOR_MONTHLY_PRICE_ID=
STRIPE_CREATOR_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STARTER_MONTHLY_CREDITS=10

# Credits
FREE_SIGNUP_CREDITS=3
CREATOR_MONTHLY_CREDITS=60
PRO_MONTHLY_CREDITS=180
CREDITS_COST_GENERATION_STANDARD=1
CREDITS_COST_GENERATION_HIGH=3
CREDITS_COST_EDIT=1
LOW_CREDIT_THRESHOLD=3

# Billing
STRIPE_BILLING_ENABLED=false
BILLING_GRACE_PERIOD_DAYS=3

# Durable jobs and operations (server only)
JOBS_WORKER_ENABLED=true
JOBS_GLOBAL_CONCURRENCY=3
JOBS_USER_CONCURRENCY=1
JOBS_VISIBILITY_TIMEOUT_SECONDS=300
JOBS_MAX_ATTEMPTS=4
CRON_SECRET=
IP_HASH_SALT=

# Error tracking and operational alerts
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
ALERT_GENERATION_FAILURE_RATE=0.15
ALERT_GENERATION_MIN_SAMPLE=5
ALERT_STUCK_JOB_MINUTES=15
ALERT_OPEN_RESERVATION_MINUTES=30
ALERT_OPENAI_LATENCY_MS=90000
ALERT_DAILY_BUDGET_RATIO=0.8

# Optional OpenAI safety budgets. Leave blank to disable the monetary guard.
OPENAI_DAILY_BUDGET_USD=
OPENAI_MONTHLY_BUDGET_USD=
# Configure estimates from your own measured/current provider costs.
OPENAI_GENERATION_STANDARD_ESTIMATED_COST_USD=
OPENAI_GENERATION_HIGH_ESTIMATED_COST_USD=
OPENAI_EDIT_ESTIMATED_COST_USD=

# Private upload quotas
UPLOAD_MAX_FILES_PER_USER=100
UPLOAD_MAX_TOTAL_MB_PER_USER=500

# Private object storage. Use supabase locally while R2 is not configured.
OBJECT_STORAGE_PROVIDER=supabase
# Legacy alias during migration.
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=generations
# Required only when OBJECT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Leave empty for private files.
R2_PUBLIC_BASE_URL=

# Trigger.dev durable job consumer. Keep disabled until the project, production
# secret and task deployment are configured. The recovery cron remains active.
TRIGGER_ENABLED=false
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Asset retention
TEMPORARY_ASSET_RETENTION_HOURS=24
UPLOAD_UNUSED_RETENTION_HOURS=24
UPLOADED_FILE_RETENTION_DAYS=7
FREE_ASSET_RETENTION_DAYS=7
STARTER_ASSET_RETENTION_DAYS=7
CREATOR_ASSET_RETENTION_DAYS=30
PRO_ASSET_RETENTION_DAYS=90
PREVIEW_RETENTION_DAYS=180
DELETION_GRACE_PERIOD_DAYS=7

# Storage quotas
FREE_STORAGE_LIMIT_MB=
STARTER_STORAGE_LIMIT_MB=
CREATOR_STORAGE_LIMIT_MB=
PRO_STORAGE_LIMIT_MB=
MAX_SINGLE_UPLOAD_MB=10

# Launch
NEXT_PUBLIC_LAUNCH_STAGE=production
REGISTRATIONS_ENABLED=true
INVITE_REQUIRED=false
ONBOARDING_ENABLED=true
TOOLS_ENABLED=true

# Transactional email (server only except where explicitly public)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_NAME=Crealy
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
TRANSACTIONAL_EMAILS_ENABLED=false
SUPPORT_EMAIL_ADDRESS=ayuda@crealy.app

# Crealy HQ (server only). Comma-separated values are supported.
HQ_HOST=hq.crealy.app
HQ_ADMIN_EMAILS=
HQ_ADMIN_USER_IDS=

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false
NEXT_PUBLIC_SPEED_INSIGHTS_ENABLED=false

# Support and feedback
SUPPORT_FORM_ENABLED=true
SUPPORT_REQUESTS_PER_HOUR=5
PRODUCT_FEEDBACK_ENABLED=true
DATA_EXPORT_ENABLED=false
ACCOUNT_DELETION_ENABLED=false

# Legal identity. Keep aligned with src/config/legal.ts.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=YellowCat Enterprises LLC
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=hola@crealy.app
NEXT_PUBLIC_LEGAL_COUNTRY=República de Panamá
NEXT_PUBLIC_TERMS_EFFECTIVE_DATE=10 de agosto de 2026
NEXT_PUBLIC_PRIVACY_EFFECTIVE_DATE=10 de agosto de 2026
